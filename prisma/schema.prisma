generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Auth tables (managed by NextAuth / @auth/prisma-adapter) ──

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?   // null for OAuth users
  plan          String    @default("free")  // free | trialing | pro
  trialEndsAt   DateTime?
  digestEnabled Boolean   @default(true)
  createdAt     DateTime  @default(now())
  lastActiveAt  DateTime?

  accounts      Account[]
  sessions      Session[]
  categories    Category[]
  subcategories Subcategory[]
  tasks         Task[]
  integration   UserIntegration?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── App tables ─────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isInbox   Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subcategories Subcategory[]
  tasks         Task[]

  @@index([userId])
}

model Subcategory {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  name       String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tasks    Task[]

  @@unique([categoryId, name])
  @@index([userId])
}

model Task {
  id            String    @id @default(cuid())
  userId        String
  categoryId    String?
  subcategoryId String?
  title         String
  notes         String?
  priority      String    @default("P2")     // P0 | P1 | P2 | P3
  effort        String    @default("Medium") // Quick | Medium | Deep
  status        String    @default("Todo")   // Todo | In Progress | Waiting On | Done
  waitingOn     String?
  dueDate       DateTime?
  source        String    @default("manual") // manual | slack | api
  slackTs       String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, status])
}

model UserIntegration {
  userId         String   @id
  slackToken     String?
  slackTeamId    String?
  slackChannelId String?
  slackLastTs    String?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DigestLog {
  id        String   @id @default(cuid())
  userId    String
  sentAt    DateTime @default(now())
  taskCount Int?
  openP0    Int?
  openP1    Int?
}

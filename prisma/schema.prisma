generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Auth tables (managed by NextAuth / @auth/prisma-adapter) ──

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?   // null for OAuth users
  plan          String    @default("free")  // free | trialing | pro
  trialEndsAt   DateTime?
  digestEnabled Boolean   @default(true)
  createdAt     DateTime  @default(now())
  lastActiveAt  DateTime?

  accounts    Account[]
  sessions    Session[]
  areas       Area[]
  tasks       Task[]
  integration UserIntegration?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── App tables ─────────────────────────────────────────────────

model Area {
  id        String   @id @default(cuid())
  userId    String
  name      String
  groupName String   @default("General")
  sortOrder Int      @default(0)
  isInbox   Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])  // #18/#19 — fast per-user lookups
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  areaId      String?
  title       String
  notes       String?
  priority    String    @default("P2")     // P0 | P1 | P2 | P3
  effort      String    @default("Medium") // Quick | Medium | Deep
  status      String    @default("Todo")   // Todo | In Progress | Waiting On | Done
  waitingOn   String?
  dueDate     DateTime?
  source      String    @default("manual") // manual | slack | api
  slackTs     String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // #22 — onDelete: Restrict matches the API-level block; tasks cannot be orphaned
  area Area? @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@index([userId])        // #18 — fast per-user task fetches
  @@index([userId, status]) // common filter: active tasks per user
}

model UserIntegration {
  userId         String   @id
  slackToken     String?
  slackChannelId String?
  slackLastTs    String?
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DigestLog {
  id        String   @id @default(cuid())
  userId    String
  sentAt    DateTime @default(now())
  taskCount Int?
  openP0    Int?
  openP1    Int?
}
